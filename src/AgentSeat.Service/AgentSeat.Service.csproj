<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763</SupportedOSPlatformVersion>
    <AssemblyName>AgentSeat</AssemblyName>
    <RootNamespace>AgentSeat.Service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentSeat.Core\AgentSeat.Core.csproj" />
    <ProjectReference Include="..\AgentSeat.Windows\AgentSeat.Windows.csproj" />
    <ProjectReference Include="..\AgentSeat.AgentHelper\AgentSeat.AgentHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <Target Name="CopyAgentHelper" AfterTargets="Build">
    <ItemGroup>
      <_AgentHelperFiles Include="..\AgentSeat.AgentHelper\bin\$(Configuration)\$(TargetFramework)\AgentSeat.AgentHelper.*" />
      <_AgentHelperFiles Include="..\AgentSeat.AgentHelper\bin\$(Configuration)\$(TargetFramework)\AgentSeat.Core.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentHelperFiles)" DestinationFolder="$(OutDir)agent-helper" SkipUnchangedFiles="true" />
  </Target>
</Project>
